%{
#include <stdio.h>

int change_int(const char *str) {
    int result = 0;
    int i = 0;

    while (str[i] != '\0') {
        result = (result * 10) + (str[i] - '0');
        i++;
    }

    return result;
}

void int_to_hex(int num) {
    char hex[100];
    int i = 0;

    if (num == 0) {
        printf("0");
        return;
    }

    while (num > 0) {
        int remainder = num % 16;

        if (remainder < 10)
            hex[i] = remainder + '0';
        else
            hex[i] = remainder - 10 + 'A';

        i++;
        num = num / 16;
    }
    for (i = i - 1; i >= 0; i--) {
        printf("%c", hex[i]);
    }
}
%}
%%
[0-9]+  {int decimal_num = change_int(yytext);
            int_to_hex(decimal_num);}
.       {ECHO; }
%%

int yywrap() {
    return 1;
}

