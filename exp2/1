%{
#include<stdio.h>

int kw=0,id=0,com=0,word=0,line=0,space=0;
%}

%%
"int"|"float"|"char"|"if"|"else"|"while"|"for"|"return"    {kw++; word++;}
[a-zA-Z_][a-zA-Z0-9_]*                                     {id++; word++;}
"//".*                                                     {com++;}
"/*"([^*]|\*+[^*/])*\*+"/"                                 {com++;}
" "                                                        {space++;}
\n                                                         {line++;}
.                                                          ;
%%

int yywrap()
{
    return 1;
}

int main()
{
    yyin=fopen("input.txt","r");
    yylex();

    printf("Keywords = %d\n",kw);
    printf("Identifiers = %d\n",id);
    printf("Comments = %d\n",com);
    printf("Words = %d\n",word);
    printf("Lines = %d\n",line);
    printf("Spaces = %d\n",space);

    return 0;
}
